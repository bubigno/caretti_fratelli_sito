# Configurazione del pannello admin — file di esempio.
# Copia questo file in ".env.local" e inserisci i valori reali.

# Nome utente per l'accesso all'area admin
ADMIN_USERNAME=admin

# Password dell'admin come HASH BCRYPT (NON la password in chiaro).
# Per generare l'hash: node -e "console.log(require('bcryptjs').hashSync('LA_TUA_PASSWORD', 10))"
ADMIN_PASSWORD=$2a$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Segreto per la firma dei token di sessione (JWT).
# Genera una stringa casuale sicura: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=inserisci-una-stringa-casuale-sicura

# URL pubblico del sito
NEXTAUTH_URL=https://carettifratellisito.vercel.app
